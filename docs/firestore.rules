rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /calls/{callId} {
      allow create: if request.auth != null && request.resource.data.caller == request.auth.uid;
      allow read, update: if request.auth != null && (resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid);
      allow delete: if request.auth != null && resource.data.caller == request.auth.uid;
      match /{side}/{cand} {
        allow read, write: if request.auth != null && (get(/databases/$(db)/documents/calls/$(callId)).data.caller == request.auth.uid || get(/databases/$(db)/documents/calls/$(callId)).data.callee == request.auth.uid);
      }
    }
  }
}
